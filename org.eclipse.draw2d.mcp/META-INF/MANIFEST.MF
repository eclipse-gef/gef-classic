Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %Plugin.name
Bundle-SymbolicName: org.eclipse.draw2d.mcp;singleton:=true
Bundle-Vendor: %Plugin.providerName
Bundle-Localization: plugin
Bundle-Version: 1.0.0.qualifier
Export-Package: org.eclipse.draw2d.mcp,
 org.eclipse.draw2d.mcp.internal;x-internal:=true
Import-Package: jakarta.servlet;version="[6.1.0,7.0.0)"
Require-Bundle: io.modelcontextprotocol.sdk.mcp-core;bundle-version="[2.1.0,3.0.0)",
 io.modelcontextprotocol.sdk.mcp-json-jackson3;bundle-version="[2.1.0,3.0.0)",
 tools.jackson.core.jackson-core;bundle-version="[3.1.4,4.0.0)",
 tools.jackson.core.jackson-databind;bundle-version="[3.1.4,4.0.0)",
 org.eclipse.core.runtime;bundle-version="[3.31.100,4.0.0)",
 org.eclipse.jetty.server;bundle-version="[12.0.12,13.0.0)",
 org.eclipse.jetty.ee10.servlet;bundle-version="[12.0.12,13.0.0)"
Automatic-Module-Name: org.eclipse.draw2d.mcp
Bundle-RequiredExecutionEnvironment: JavaSE-21
Service-Component: OSGI-INF/org.eclipse.draw2d.mcp.internal.MCPServer.xml
Bundle-ActivationPolicy: lazy
